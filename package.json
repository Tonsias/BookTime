{
  "name": "booktime",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "check:dead": "knip",
    "check:dup": "jscpd",
    "check:docs": "node scripts/check-docs.mjs --min-exports=100 --max-comments=5",
    "check": "npm run lint && npm run check:dead && npm run check:dup && npm run check:docs"
  },
  "dependencies": {
    "@mantine/core": "^9.7.3",
    "@mantine/hooks": "^9.7.3",
    "@mantine/spotlight": "^9.7.3",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jscpd": "^5.4.1",
    "knip": "^6.41.0",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
